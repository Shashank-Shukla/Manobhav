# Safe placeholders only. Do not put real secrets in this file.

# Local PostgreSQL for Docker Compose
POSTGRES_USER=manobhav
POSTGRES_PASSWORD=
POSTGRES_DB=manobhav
POSTGRES_PORT=5432

# Local service ports/origins
API_PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# ASP.NET Core local placeholders. Production should source private values from
# AWS SSM Parameter Store, not committed files.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=
Cors__AllowedOrigins__0=http://localhost:5173
Auth__Enabled=false
Auth__CognitoAuthority=
Auth__CognitoDomain=
Auth__Audience=
Auth__AdminGroup=Admin
Auth__RequireHttpsMetadata=true
Auth__CookieDomain=
VisitorAnalytics__Enabled=true
VisitorAnalytics__FullCaptureEnabled=false
VisitorAnalytics__FullCaptureLegalApproved=false
VisitorAnalytics__CapturePreciseLocation=false
VisitorAnalytics__RetentionDays=90
AWS__SystemsManager__Enabled=false
AWS__SystemsManager__Path=/manobhav/prod/
AWS__SystemsManager__Optional=true
AWS__SystemsManager__ReloadAfterMinutes=5

# Client-exposed Vite variables are public. Never put private secrets, tokens,
# cookies, passwords, payment data, auth headers, clinical notes, or admin data
# behind VITE_ variables.
VITE_PUBLIC_API_BASE_URL=https://api.manobhav.co.in
VITE_PUBLIC_ENABLE_VISITOR_ANALYTICS=false
VITE_PUBLIC_ENABLE_FULL_VISITOR_CAPTURE=false
VITE_PUBLIC_ANALYTICS_LEGAL_APPROVED=false
VITE_PUBLIC_ANALYTICS_PRECISE_LOCATION=false
VITE_PUBLIC_COGNITO_DOMAIN=https://your-cognito-domain.auth.ap-south-2.amazoncognito.com
VITE_PUBLIC_COGNITO_CLIENT_ID=
VITE_PUBLIC_COGNITO_REDIRECT_URI=https://localhost:5173/callback
VITE_PUBLIC_COGNITO_LOGOUT_URI=https://localhost:5173/
VITE_PUBLIC_COGNITO_SCOPES=openid email profile
VITE_PUBLIC_ADMIN_GROUP=Admin
