{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "api.example.com",
  "Cors": {
    "AllowedOrigins": [
      "https://www.example.com"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "VisitorAnalytics": {
    "Enabled": true,
    "FullCaptureEnabled": false,
    "FullCaptureLegalApproved": false,
    "CapturePreciseLocation": false,
    "RetentionDays": 90
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Auth": {
    "Enabled": true,
    "CognitoAuthority": "https://cognito-idp.ap-south-2.amazonaws.com/ap-south-2_example",
    "Audience": "cognito-user-pool-app-client-id",
    "AdminGroup": "Admin",
    "RequireHttpsMetadata": true
  },
  "AWS": {
    "SystemsManager": {
      "Enabled": true,
      "Path": "/manobhav/production/",
      "Optional": false,
      "ReloadAfterMinutes": 5
    }
  }
}
